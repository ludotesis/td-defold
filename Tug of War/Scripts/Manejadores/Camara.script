function on_input(self, action_id, action)
	if action_id == hash("izq") and action.pressed then
		local p = go.get_position(".")
		if p.x > MIN_X then
			p.x = p.x - STEP
			go.set_position(p, ".")
		end
	elseif action_id == hash("der") and action.pressed then
		local p = go.get_position(".")
		if p.x < MAX_X then
			p.x = p.x + STEP
			go.set_position(p, ".")
		end
	end
end

