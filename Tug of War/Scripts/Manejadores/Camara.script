local MIN_X = 640
local MAX_X = 1920
local STEP  = 320

function init(self)
	msg.post(".", "acquire_input_focus")
	local p = go.get_position(".")
	print("MI POSICION ES"..p)
	--go.animate(".", "position.x", go.PLAYBACK_LOOP_PINGPONG, 2000, go.EASING_INOUTQUAD, 10)
	--go.set_position(position, id)
	
end

